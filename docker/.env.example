# Copy to docker/.env (git-ignored) and change every value.
POSTGRES_USER=sublimalab
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional bootstrap administrator (created on first start).
ADMIN_EMAIL=admin@sublimalab.local
ADMIN_PASSWORD=Change-Me-Admin-123

# Optional: send traces, metrics and logs to an OpenTelemetry collector or vendor (OTLP).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_HEADERS=api-key=replace-me
