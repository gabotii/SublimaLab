@*
    The storefront's HTML document. Public pages (home, catalog, products, help) are prerendered on
    the server, so they arrive as complete HTML for visitors and crawlers; WebAssembly then takes
    over in place. Private and per-visitor pages render only in the browser, behind a loading shell.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="SublimaLab: custom T-shirts, mugs and keychains with your own artwork. Design online, preview it live and order in minutes." />
    <meta name="theme-color" content="#7c3aed" />
    <base href="/" />
    @if (!_prerender)
    {
        <title>SublimaLab — Custom T-shirts, mugs &amp; keychains</title>
    }
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preload" href="fonts/poppins-800-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="css/app.css" />
    <HeadOutlet @rendermode="_renderMode" />
</head>
<body>
    @if (!_prerender)
    {
        @* Same header markup as the app, plus a page skeleton; hidden by CSS once the app renders. *@
        <div id="app-shell" aria-busy="true">
            <header class="site-header">
                <div class="container site-header__inner">
                    <a class="logo" href="" aria-label="SublimaLab home">
                        <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
                            <defs><linearGradient id="shell-logo" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#7c3aed" /><stop offset="0.55" stop-color="#d946ef" /><stop offset="1" stop-color="#06b6d4" /></linearGradient></defs>
                            <rect width="48" height="48" rx="14" fill="url(#shell-logo)" />
                            <path d="M15 30c0 3 3 5 8 5 6 0 9-3 9-6.5 0-8-15-5-15-11 0-2.4 2.6-4 6.5-4 3.4 0 6 1.3 7 3.6" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" />
                        </svg>
                        <span>Sublima<span class="logo__lab">Lab</span></span>
                    </a>
                    <nav class="nav" aria-label="Main">
                        <ul class="nav__links">
                            <li><a class="nav__link" href="shop">Shop all</a></li>
                            <li><a class="nav__link" href="shop/t-shirts">T-Shirts</a></li>
                            <li><a class="nav__link" href="shop/mugs">Mugs</a></li>
                            <li><a class="nav__link" href="shop/keychains">Keychains</a></li>
                        </ul>
                    </nav>
                    <div class="header-actions">
                        <a class="btn btn--primary btn--sm" href="shop?customizable=true">Create your design</a>
                        <span class="icon-btn" aria-hidden="true"></span>
                        <span class="icon-btn" aria-hidden="true"></span>
                        <span class="icon-btn nav-toggle" aria-hidden="true"></span>
                    </div>
                </div>
            </header>
            <main>
                <div class="container" role="status">
                    <div class="skeleton skeleton--title" style="margin-top:var(--space-6)"></div>
                    <div class="skeleton skeleton--line" style="width:55%"></div>
                    <div class="skeleton skeleton--block" style="margin-top:var(--space-5)"></div>
                    <span class="visually-hidden">Loading SublimaLab…</span>
                </div>
            </main>
        </div>
    }

    <Routes @rendermode="_renderMode" />

    <div id="blazor-error-ui" role="alert">
        Something went wrong. <a href="" class="reload">Reload the page</a>
        <button type="button" class="dismiss" aria-label="Dismiss">×</button>
    </div>
    <noscript><p class="noscript">Some features of SublimaLab, like the design studio and checkout, need JavaScript.</p></noscript>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private bool _prerender;
    private IComponentRenderMode _renderMode = StorefrontRendering.ClientOnly;

    protected override void OnInitialized()
    {
        _prerender = StorefrontRendering.ShouldPrerender(HttpContext);
        _renderMode = _prerender ? StorefrontRendering.Prerendered : StorefrontRendering.ClientOnly;
    }
}
