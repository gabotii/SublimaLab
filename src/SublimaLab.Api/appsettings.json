{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "App": {
    "PublicBaseUrl": "https://sublimalab.example"
  },
  "Auth": {
    "RequireConfirmedEmail": true
  },
  "Commerce": {
    "Currency": "USD",
    "TaxRate": 0.08,
    "DefaultShippingMethodCode": "standard"
  },
  "Uploads": {
    "MaxArtworkBytes": 15728640,
    "MaxPreviewBytes": 2097152,
    "MinDimensionPx": 64,
    "MaxDimensionPx": 12000,
    "MaxMegapixels": 80,
    "LowResolutionWarningPx": 1500
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "hello@sublimalab.example",
    "FromName": "SublimaLab"
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1,
    "TrustAllProxies": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPermitLimit": 300,
    "AuthPermitLimit": 10,
    "UploadPermitLimit": 30
  },
  "Seed": {
    "SeedCatalog": true
  }
}
