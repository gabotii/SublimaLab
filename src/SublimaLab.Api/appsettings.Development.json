{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/sublimalab.dev.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true
  },
  "App": {
    "PublicBaseUrl": "https://localhost:7132"
  },
  "Email": {
    "Provider": "Pickup",
    "PickupDirectory": "App_Data/mail"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7200", "http://localhost:5173" ]
  },
  "Auth": {
    "RequireAdminTwoFactor": false
  },
  "Seed": {
    "SeedCatalog": true,
    "AdminEmail": "admin@sublimalab.local",
    "AdminPassword": "LocalDevOnly-Admin1"
  }
}
