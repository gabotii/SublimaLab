@inject NavigationManager Navigation

<div class="page-loading" role="status"><span class="spinner"></span><span class="visually-hidden">Redirecting to sign in…</span></div>

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"account/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
