<div class="qty @(Small ? "qty--sm" : null)" role="group" aria-label="@Label">
    <button type="button" @onclick="() => ChangeAsync(-1)" disabled="@(Disabled || Value <= Min)" aria-label="Decrease quantity">−</button>
    <output aria-live="polite" aria-label="Quantity">@Value</output>
    <button type="button" @onclick="() => ChangeAsync(1)" disabled="@(Disabled || Value >= Max)" aria-label="Increase quantity">+</button>
</div>

@code {
    [Parameter] public int Value { get; set; } = 1;
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public int Min { get; set; } = 1;
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Small { get; set; }
    [Parameter] public string Label { get; set; } = "Quantity";

    private async Task ChangeAsync(int delta)
    {
        var next = Math.Clamp(Value + delta, Min, Max);
        if (next != Value)
        {
            await ValueChanged.InvokeAsync(next);
        }
    }
}
