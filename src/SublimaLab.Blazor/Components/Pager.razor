@inject NavigationManager Navigation

@if (TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination">
            <li>
                @if (Page > 1)
                {
                    <a href="@Href(Page - 1)" aria-label="Previous page">‹</a>
                }
                else
                {
                    <span class="disabled" aria-hidden="true">‹</span>
                }
            </li>
            @foreach (var p in Pages)
            {
                <li><a href="@Href(p)" aria-current="@(p == Page ? "page" : null)" aria-label="Page @p">@p</a></li>
            }
            <li>
                @if (Page < TotalPages)
                {
                    <a href="@Href(Page + 1)" aria-label="Next page">›</a>
                }
                else
                {
                    <span class="disabled" aria-hidden="true">›</span>
                }
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }

    // A window of at most 7 page links around the current page.
    private IEnumerable<int> Pages
    {
        get
        {
            var start = Math.Max(1, Math.Min(Page - 3, TotalPages - 6));
            return Enumerable.Range(start, Math.Min(7, TotalPages - start + 1));
        }
    }

    private string Href(int page) => Navigation.GetUriWithQueryParameter("page", page == 1 ? null : page);
}
