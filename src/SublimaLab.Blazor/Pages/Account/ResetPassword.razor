@page "/account/reset-password"
@inject ApiClient Api

<PageTitle>Choose a new password — SublimaLab</PageTitle>

<div class="container auth">
    <div class="card auth__card">
        @if (_done)
        {
            <div class="confirmation" style="margin-bottom:0">
                <div class="confirmation__icon"><Icon Name="check" /></div>
                <h1>Password updated</h1>
                <p>You can now sign in with your new password.</p>
                <a class="btn btn--primary" href="account/login">Sign in</a>
            </div>
        }
        else if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            <h1>This link is incomplete</h1>
            <p class="text-muted">Open the link from your email again, or request a new one.</p>
            <a class="btn btn--primary btn--block" href="account/forgot-password">Request a new link</a>
        }
        else
        {
            <h1>Choose a new password</h1>
            <p class="text-muted">For <strong>@Email</strong></p>
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="reset" class="form-grid">
                <DataAnnotationsValidator />
                <ServerErrors Error="_error" HandledFields="HandledFields">
                    @if (_error?.Code == "INVALID_TOKEN")
                    {
                        <a href="account/forgot-password">Request a new link</a>
                    }
                </ServerErrors>
                <div class="field">
                    <label class="field__label" for="reset-password">New password</label>
                    <InputText id="reset-password" class="input" type="password" autocomplete="new-password" @bind-Value="_model.Password" />
                    <span class="field__hint">At least 10 characters, with an uppercase letter, a lowercase letter and a number.</span>
                    <ValidationMessage For="() => _model.Password" />
                    <FieldError Error="_error" Field="newPassword" />
                </div>
                <div class="field">
                    <label class="field__label" for="reset-confirm">Confirm new password</label>
                    <InputText id="reset-confirm" class="input" type="password" autocomplete="new-password" @bind-Value="_model.Confirm" />
                    <ValidationMessage For="() => _model.Confirm" />
                </div>
                <button type="submit" class="btn btn--primary btn--lg btn--block" disabled="@_submitting">Update password</button>
            </EditForm>
        }
    </div>
</div>

@code {
    private static readonly string[] HandledFields = ["newPassword"];

    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetModel _model = new();
    private ApiException? _error;
    private bool _submitting;
    private bool _done;

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            await Api.PostAsync("api/auth/reset-password", new ResetPasswordRequest(Email!, Token!, _model.Password));
            _done = true;
        }
        catch (ApiException e)
        {
            _error = e;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class ResetModel
    {
        [Required(ErrorMessage = "Choose a new password.")]
        [MinLength(10, ErrorMessage = "Use at least 10 characters.")]
        [RegularExpression("^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).+$", ErrorMessage = "Include an uppercase letter, a lowercase letter and a number.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirm your new password.")]
        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string Confirm { get; set; } = string.Empty;
    }
}
