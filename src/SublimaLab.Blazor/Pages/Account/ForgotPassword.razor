@page "/account/forgot-password"
@inject ApiClient Api

<PageTitle>Reset your password — SublimaLab</PageTitle>

<div class="container auth">
    <div class="card auth__card">
        @if (_sent)
        {
            <div class="confirmation" style="margin-bottom:0">
                <div class="confirmation__icon"><Icon Name="mail" /></div>
                <h1>Check your inbox</h1>
                <p>If an account exists for <strong>@_model.Email</strong>, we've sent a link to reset your password.</p>
                <a class="btn btn--primary" href="account/login">Back to sign in</a>
            </div>
        }
        else
        {
            <h1>Forgot your password?</h1>
            <p class="text-muted">Enter your email and we'll send you a link to choose a new one.</p>
            <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="forgot" class="form-grid">
                <DataAnnotationsValidator />
                <ServerErrors Error="_error" />
                <div class="field">
                    <label class="field__label" for="forgot-email">Email</label>
                    <InputText id="forgot-email" class="input" type="email" autocomplete="email" @bind-Value="_model.Email" />
                    <ValidationMessage For="() => _model.Email" />
                </div>
                <button type="submit" class="btn btn--primary btn--lg btn--block" disabled="@_submitting">Send reset link</button>
            </EditForm>
            <p class="auth__footer"><a href="account/login">Back to sign in</a></p>
        }
    </div>
</div>

@code {
    private readonly EmailModel _model = new();
    private bool _sent;
    private bool _submitting;
    private ApiException? _error;

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            await Api.PostAsync("api/auth/forgot-password", new EmailRequest(_model.Email.Trim()));
            _sent = true;
        }
        catch (ApiException e)
        {
            _error = e;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class EmailModel
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;
    }
}
