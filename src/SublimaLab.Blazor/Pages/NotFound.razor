@page "/not-found"
@page "/{*path:nonfile}"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Page not found — SublimaLab</PageTitle>

<div class="container section">
    <div class="empty-state">
        <Icon Name="search" Class="empty-state__icon" />
        <h1>We couldn't find that page</h1>
        <p>The link may be broken or the page may have moved. Let's get you back to creating.</p>
        <div class="row" style="justify-content:center">
            <a class="btn btn--primary" href="">Go home</a>
            <a class="btn btn--secondary" href="shop">Browse products</a>
        </div>
    </div>
</div>

@code {
    /// <summary>Set when no other page matched (catch-all route).</summary>
    [Parameter] public string? Path { get; set; }

    // Unknown URLs land here; NotFound() makes the server answer 404 and the router show this page.
    protected override void OnInitialized()
    {
        if (Path is not null)
        {
            Navigation.NotFound();
        }
    }
}
