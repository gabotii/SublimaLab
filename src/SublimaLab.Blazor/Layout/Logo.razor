<a class="logo" href="" aria-label="SublimaLab home">
    <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true">
        <defs>
            <linearGradient id="@_gradientId" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#7c3aed" />
                <stop offset="0.55" stop-color="#d946ef" />
                <stop offset="1" stop-color="#06b6d4" />
            </linearGradient>
        </defs>
        <rect width="48" height="48" rx="14" fill="url(#@_gradientId)" />
        <path d="M15 30c0 3 3 5 8 5 6 0 9-3 9-6.5 0-8-15-5-15-11 0-2.4 2.6-4 6.5-4 3.4 0 6 1.3 7 3.6" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" />
    </svg>
    <span>Sublima<span class="logo__lab">Lab</span></span>
</a>

@code {
    // The logo appears more than once per page (header, footer): SVG ids must be unique.
    private readonly string _gradientId = "logo-g-" + Guid.NewGuid().ToString("N")[..8];
}
